<Application x:Class="MailCraftAI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:MailCraftAI.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/Icons.xaml" />
                <ResourceDictionary Source="Styles/LightTheme.xaml" />
                <ResourceDictionary Source="Styles/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Converters -->
            <converters:BooleanToVisibilityConverter x:Key="BoolToVis" />
            <converters:BooleanToVisibilityConverter x:Key="InverseBoolToVis" Invert="True" />
            <converters:NullToVisibilityConverter x:Key="NullToVis" />
            <converters:NullToVisibilityConverter x:Key="InverseNullToVis" Invert="True" />
            <converters:EnumToBooleanConverter x:Key="EnumToBool" />
            <converters:EnumToVisibilityConverter x:Key="EnumToVis" />
            <converters:EnumToVisibilityConverter x:Key="InverseEnumToVis" Invert="True" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
