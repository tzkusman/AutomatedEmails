<Window x:Class="MailCraftAI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:MailCraftAI.ViewModels"
        xmlns:models="clr-namespace:MailCraftAI.Models"
        mc:Ignorable="d"
        Title="MailCraft AI - Outlook Assistant"
        Icon="Assets/AppIcon.ico"
        Height="820" Width="1280"
        MinHeight="680" MinWidth="1040"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BrushBackground}"
        Foreground="{DynamicResource BrushTextPrimary}"
        FontFamily="Segoe UI, Segoe UI Variable, Arial, sans-serif">

    <Grid>
        <!-- Main Application Shell -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- Top Header -->
                <RowDefinition Height="*" />    <!-- 2-Panel Content Area -->
                <RowDefinition Height="Auto" /> <!-- Bottom Status Bar -->
            </Grid.RowDefinitions>

            <!-- ================= TOP HEADER BAR ================= -->
            <Border Grid.Row="0"
                    Background="{DynamicResource BrushHeaderGradient}"
                    BorderBrush="{DynamicResource BrushBorder}"
                    BorderThickness="0,0,0,1"
                    Padding="20,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- App Brand & Title -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="36" Height="36" CornerRadius="9"
                                Background="{DynamicResource BrushCard}"
                                BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"
                                Margin="0,0,12,0" VerticalAlignment="Center">
                            <Image Source="Assets/Logo.png" Width="26" Height="26"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="MailCraft" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" />
                                <TextBlock Text="AI" FontSize="17" FontWeight="ExtraBold" Foreground="{DynamicResource BrushAccent}" Margin="2,0,0,0" />
                                <Border Background="#EEF2FF" CornerRadius="4" Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="PRO" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushAccent}" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Classic Outlook Assistant • Production Edition" FontSize="11" Foreground="{DynamicResource BrushTextMuted}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Center Badges: Outlook Status & Active AI Provider -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <!-- Outlook Status Pill -->
                        <Button Style="{StaticResource StyleSecondaryButton}"
                                Command="{Binding RefreshOutlookStatusCommand}"
                                Padding="10,5" Margin="0,0,10,0" ToolTip="Click to check or start Outlook">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="9" Height="9" Fill="{Binding OutlookStatusBrush}" Margin="0,0,8,0" />
                                <TextBlock Text="{Binding OutlookStatus.Message}" FontSize="11.5" MaxWidth="320" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Button>

                        <!-- Active AI Model Badge -->
                        <Border Background="{DynamicResource BrushCard}"
                                BorderBrush="{DynamicResource BrushBorder}"
                                BorderThickness="1" CornerRadius="7" Padding="10,5">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconSparkles}" Fill="{DynamicResource BrushAccent}"
                                      Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" />
                                <TextBlock Text="{Binding ActiveAiProviderBadge}" FontSize="11.5" FontWeight="Medium" Foreground="{DynamicResource BrushTextSecondary}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Right Controls: History, Privacy, Settings, Theme -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- History Button -->
                        <Button Style="{StaticResource StyleSecondaryButton}"
                                Command="{Binding OpenHistoryCommand}"
                                Margin="0,0,8,0" ToolTip="View Past Generated Replies">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconHistory}" Fill="{DynamicResource BrushTextSecondary}"
                                      Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0" />
                                <TextBlock Text="History" FontSize="12" />
                            </StackPanel>
                        </Button>

                        <!-- Privacy Notice Button -->
                        <Button Style="{StaticResource StyleSecondaryButton}"
                                Command="{Binding OpenPrivacyNoticeCommand}"
                                Margin="0,0,8,0" ToolTip="Privacy &amp; Data Handling Notice">
                            <Path Data="{StaticResource IconShield}" Fill="{DynamicResource BrushTextSecondary}"
                                  Width="14" Height="14" Stretch="Uniform" />
                        </Button>

                        <!-- Settings Button -->
                        <Button Style="{StaticResource StyleSecondaryButton}"
                                Command="{Binding OpenSettingsCommand}"
                                Margin="0,0,8,0" ToolTip="Settings, API Keys &amp; Business Profile">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconGear}" Fill="{DynamicResource BrushTextSecondary}"
                                      Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0" />
                                <TextBlock Text="Settings" FontSize="12" />
                            </StackPanel>
                        </Button>

                        <!-- Theme Toggle Button -->
                        <Button Style="{StaticResource StyleIconButton}"
                                Click="OnToggleThemeClicked"
                                ToolTip="Toggle Light / Dark Mode">
                            <TextBlock Text="🌓" FontSize="15" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ================= 2-PANEL WORKSPACE ================= -->
            <Grid Grid.Row="1" Margin="20,16,20,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="420" />
                    <ColumnDefinition Width="16" /> <!-- Split gap -->
                    <ColumnDefinition Width="*" MinWidth="440" />
                </Grid.ColumnDefinitions>

                <!-- ================= LEFT PANEL: INPUT & CONTEXT ================= -->
                <Border Grid.Column="0"
                        Background="{DynamicResource BrushSurface}"
                        BorderBrush="{DynamicResource BrushBorder}"
                        BorderThickness="1" CornerRadius="12" Padding="18">
                    <Grid DataContext="{Binding InputVm}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /> <!-- Source Selector -->
                            <RowDefinition Height="*" />    <!-- Context Card / Input Area -->
                            <RowDefinition Height="Auto" /> <!-- Instructions & Chips -->
                            <RowDefinition Height="Auto" /> <!-- Generation Options -->
                        </Grid.RowDefinitions>

                        <!-- 1. Input Source Segmented Tabs -->
                        <Border Grid.Row="0"
                                Background="{DynamicResource BrushCard}"
                                BorderBrush="{DynamicResource BrushBorder}"
                                BorderThickness="1" CornerRadius="8" Padding="3" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <RadioButton Grid.Column="0" Content="Outlook Email"
                                             Style="{StaticResource StyleSegmentedTab}"
                                             IsChecked="{Binding SelectedSourceType, Converter={StaticResource EnumToBool}, ConverterParameter=Outlook}" />
                                <RadioButton Grid.Column="1" Content="Paste Text"
                                             Style="{StaticResource StyleSegmentedTab}"
                                             IsChecked="{Binding SelectedSourceType, Converter={StaticResource EnumToBool}, ConverterParameter=PastedText}" />
                                <RadioButton Grid.Column="2" Content="File / Attachments"
                                             Style="{StaticResource StyleSegmentedTab}"
                                             IsChecked="{Binding SelectedSourceType, Converter={StaticResource EnumToBool}, ConverterParameter=FileAttachment}" />
                            </Grid>
                        </Border>

                        <!-- 2. Dynamic Input Area based on Source Type -->
                        <Grid Grid.Row="1" Margin="0,0,0,12">
                            <!-- View 1: Outlook Selected Email -->
                            <Grid Visibility="{Binding SelectedSourceType, Converter={StaticResource EnumToVis}, ConverterParameter=Outlook}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!-- Pull Button Bar -->
                                <Grid Grid.Row="0" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Style="{StaticResource StyleSecondaryButton}"
                                            Command="{Binding PullFromOutlookCommand}"
                                            HorizontalAlignment="Left" Padding="14,8">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource IconRefresh}" Fill="{DynamicResource BrushAccent}"
                                                  Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" />
                                            <TextBlock Text="Pull Current Outlook Email" FontWeight="SemiBold" />
                                            <TextBlock Text=" (Ctrl+Alt+R)" FontSize="10.5" Foreground="{DynamicResource BrushTextMuted}" Margin="4,2,0,0" />
                                        </StackPanel>
                                    </Button>

                                    <Button Grid.Column="1" Style="{StaticResource StyleIconButton}"
                                            Command="{Binding ClearContextCommand}" ToolTip="Clear Context">
                                        <Path Data="{StaticResource IconTrash}" Fill="{DynamicResource BrushTextMuted}" Width="14" Height="14" Stretch="Uniform" />
                                    </Button>
                                </Grid>

                                <!-- Email Context Card -->
                                <Border Grid.Row="1"
                                        Background="{DynamicResource BrushCard}"
                                        BorderBrush="{DynamicResource BrushBorder}"
                                        BorderThickness="1" CornerRadius="8" Padding="12">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" /> <!-- Headers -->
                                            <RowDefinition Height="*" />    <!-- Body Preview -->
                                        </Grid.RowDefinitions>

                                        <!-- Headers Summary -->
                                        <StackPanel Grid.Row="0" Margin="0,0,0,8">
                                            <TextBlock Text="{Binding CurrentContext.Subject}" FontSize="13.5" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource BrushTextPrimary}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding CurrentContext.FormattedSender, StringFormat='From: {0}'}"
                                                       FontSize="11.5" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,3,0,0"
                                                       Visibility="{Binding CurrentContext.SenderEmail, Converter={StaticResource NullToVis}}" />
                                            <TextBlock Text="{Binding CurrentContext.AttachmentNames.Count, StringFormat='Attachments: {0} files detected'}"
                                                       FontSize="11" Foreground="{DynamicResource BrushAccent}" Margin="0,2,0,0"
                                                       Visibility="{Binding CurrentContext.AttachmentNames.Count, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>

                                        <!-- Email Body Preview Box -->
                                        <TextBox Grid.Row="1"
                                                 Text="{Binding CurrentContext.BodyText, Mode=OneWay}"
                                                 IsReadOnly="True"
                                                 VerticalScrollBarVisibility="Auto"
                                                 TextWrapping="Wrap"
                                                 Style="{StaticResource StyleRoundedTextBox}"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 Padding="0"
                                                 FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" />
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- View 2: Paste Text -->
                            <Grid Visibility="{Binding SelectedSourceType, Converter={StaticResource EnumToVis}, ConverterParameter=PastedText}">
                                <TextBox Text="{Binding PastedText, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True" AcceptsTab="True"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         Style="{StaticResource StyleRoundedTextBox}"
                                         Padding="12"
                                         FontSize="12.5" />
                            </Grid>

                            <!-- View 3: File Attachment / Drop -->
                            <Grid Visibility="{Binding SelectedSourceType, Converter={StaticResource EnumToVis}, ConverterParameter=FileAttachment}">
                                <Border Background="{DynamicResource BrushCard}"
                                        BorderBrush="{DynamicResource BrushBorder}"
                                        BorderThickness="1.5" CornerRadius="10"
                                        AllowDrop="True"
                                        Drop="OnFileDrop"
                                        DragOver="OnFileDragOver"
                                        Padding="20">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <Path Data="{StaticResource IconPaperclip}" Fill="{DynamicResource BrushAccent}"
                                              Width="32" Height="32" Stretch="Uniform" Margin="0,0,0,12" />
                                        <TextBlock Text="Drag &amp; drop .msg, .eml, .pdf, .docx, or .txt file here"
                                                   FontWeight="SemiBold" FontSize="13" TextAlignment="Center" />
                                        <TextBlock Text="Text and metadata will be automatically extracted as context."
                                                   FontSize="11" Foreground="{DynamicResource BrushTextMuted}" Margin="0,4,0,12" TextAlignment="Center" />
                                        <Button Style="{StaticResource StyleSecondaryButton}"
                                                Command="{Binding BrowseFileCommand}"
                                                Content="Browse File..." HorizontalAlignment="Center" />
                                        <TextBlock Text="{Binding CurrentContext.SummaryText}"
                                                   FontSize="11.5" Foreground="{DynamicResource BrushSuccess}" Margin="0,12,0,0"
                                                   TextAlignment="Center" TextWrapping="Wrap"
                                                   Visibility="{Binding CurrentContext.BodyText, Converter={StaticResource NullToVis}}" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>

                        <!-- Context Trimming / Token Stats Badge -->
                        <StackPanel Grid.Row="2" Margin="0,0,0,8">
                            <TextBlock Text="{Binding ContextStatsText, StringFormat='Context Size: {0}'}"
                                       FontSize="11" Foreground="{DynamicResource BrushTextMuted}" />
                            <TextBlock Text="{Binding ContextWarning}"
                                       FontSize="11" Foreground="{DynamicResource BrushWarning}"
                                       TextWrapping="Wrap" Margin="0,2,0,0"
                                       Visibility="{Binding ContextWarning, Converter={StaticResource NullToVis}}" />
                        </StackPanel>

                        <!-- 3. Instructions & Quick Chips -->
                        <StackPanel Grid.Row="2" Margin="0,24,0,12">
                            <TextBlock Text="Your Instruction (Optional):" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <TextBox Text="{Binding CustomInstruction, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource StyleRoundedTextBox}"
                                     Height="54" AcceptsReturn="True" TextWrapping="Wrap"
                                     ToolTip="E.g., decline politely, ask for revised quotation, confirm delivery by Friday" />

                            <!-- Quick Suggestion Chips -->
                            <WrapPanel Margin="0,8,0,0">
                                <Button Style="{StaticResource StyleChipButton}" Content="+ Decline Politely"
                                        Command="{Binding ApplyQuickChipCommand}" CommandParameter="decline politely" />
                                <Button Style="{StaticResource StyleChipButton}" Content="+ Ask for Revised Quote"
                                        Command="{Binding ApplyQuickChipCommand}" CommandParameter="ask for revised quotation" />
                                <Button Style="{StaticResource StyleChipButton}" Content="+ Confirm by Friday"
                                        Command="{Binding ApplyQuickChipCommand}" CommandParameter="confirm delivery by Friday" />
                                <Button Style="{StaticResource StyleChipButton}" Content="+ Request Details"
                                        Command="{Binding ApplyQuickChipCommand}" CommandParameter="request more details and timeline" />
                                <Button Style="{StaticResource StyleChipButton}" Content="+ Propose Next Tuesday"
                                        Command="{Binding ApplyQuickChipCommand}" CommandParameter="propose meeting next Tuesday at 2 PM" />
                            </WrapPanel>
                        </StackPanel>

                        <!-- 4. Generation Options (Tone, Length, Language, Persona) -->
                        <Grid Grid.Row="3">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Tone Selector -->
                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,6,8">
                                <TextBlock Text="Tone:" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,4" />
                                <ComboBox SelectedItem="{Binding SelectedTone}"
                                          Style="{StaticResource StyleModernComboBox}">
                                    <models:ToneOption>FriendlyProfessional</models:ToneOption>
                                    <models:ToneOption>Formal</models:ToneOption>
                                    <models:ToneOption>Firm</models:ToneOption>
                                    <models:ToneOption>Apologetic</models:ToneOption>
                                    <models:ToneOption>ShortAndDirect</models:ToneOption>
                                </ComboBox>
                            </StackPanel>

                            <!-- Reply Length Selector -->
                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="6,0,0,8">
                                <TextBlock Text="Length:" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,4" />
                                <ComboBox SelectedItem="{Binding SelectedLength}"
                                          Style="{StaticResource StyleModernComboBox}">
                                    <models:ReplyLengthOption>Short</models:ReplyLengthOption>
                                    <models:ReplyLengthOption>Medium</models:ReplyLengthOption>
                                    <models:ReplyLengthOption>Detailed</models:ReplyLengthOption>
                                </ComboBox>
                            </StackPanel>

                            <!-- Language Selector -->
                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,6,0">
                                <TextBlock Text="Language:" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding AvailableLanguages}"
                                          SelectedItem="{Binding SelectedLanguage}"
                                          Style="{StaticResource StyleModernComboBox}" />
                            </StackPanel>

                            <!-- Persona Selector -->
                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="6,0,0,0">
                                <TextBlock Text="Persona / Template:" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding Personas}"
                                          SelectedItem="{Binding SelectedPersona}"
                                          DisplayMemberPath="Name"
                                          Style="{StaticResource StyleModernComboBox}" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- ================= RIGHT PANEL: AI REPLY EDITOR & DRAFT ACTIONS ================= -->
                <Border Grid.Column="2"
                        Background="{DynamicResource BrushSurface}"
                        BorderBrush="{DynamicResource BrushBorder}"
                        BorderThickness="1" CornerRadius="12" Padding="18">
                    <Grid DataContext="{Binding EditorVm}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /> <!-- Editor Header & Quick Actions -->
                            <RowDefinition Height="*" />    <!-- Reply Text Editor -->
                            <RowDefinition Height="Auto" /> <!-- Status & Actions Bar -->
                        </Grid.RowDefinitions>

                        <!-- 1. Header Toolbar -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconSparkles}" Fill="{DynamicResource BrushAccent}"
                                      Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0" />
                                <TextBlock Text="Generated AI Reply" FontSize="14" FontWeight="Bold" />
                            </StackPanel>

                            <!-- Quick Refinement Actions -->
                            <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="10,0">
                                <Button Style="{StaticResource StyleChipButton}" Content="Shorten"
                                        Command="{Binding ApplyQuickActionCommand}" CommandParameter="Shorten" />
                                <Button Style="{StaticResource StyleChipButton}" Content="More Formal"
                                        Command="{Binding ApplyQuickActionCommand}" CommandParameter="MakeMoreFormal" />
                                <Button Style="{StaticResource StyleChipButton}" Content="Friendlier"
                                        Command="{Binding ApplyQuickActionCommand}" CommandParameter="MakeFriendlier" />
                                <Button Style="{StaticResource StyleChipButton}" Content="Fix Grammar"
                                        Command="{Binding ApplyQuickActionCommand}" CommandParameter="FixGrammar" />
                            </WrapPanel>

                            <!-- Copy Button -->
                            <Button Grid.Column="2" Style="{StaticResource StyleSecondaryButton}"
                                    Command="{Binding CopyReplyCommand}"
                                    Padding="10,6" ToolTip="Copy to Clipboard">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconCopy}" Fill="{DynamicResource BrushTextSecondary}"
                                          Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" />
                                    <TextBlock Text="Copy" FontSize="11.5" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- 2. Reply Text Box / Live Streaming Display -->
                        <Border Grid.Row="1"
                                Background="{DynamicResource BrushCard}"
                                BorderBrush="{DynamicResource BrushBorder}"
                                BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                            <Grid>
                                <TextBox Text="{Binding ReplyText, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True" AcceptsTab="True"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         Style="{StaticResource StyleRoundedTextBox}"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Padding="0"
                                         FontSize="13" />

                                <!-- Placeholder when empty -->
                                <TextBlock Text="Your AI reply will stream live here. Click 'Generate Reply' to begin..."
                                           Foreground="{DynamicResource BrushTextMuted}"
                                           FontSize="13" IsHitTestVisible="False" Margin="4,4,0,0"
                                           Visibility="{Binding ReplyText, Converter={StaticResource InverseNullToVis}}" />
                            </Grid>
                        </Border>

                        <!-- 3. Status Bar & Draft Actions -->
                        <StackPanel Grid.Row="2">
                            <!-- Error Banner -->
                            <Border Background="{DynamicResource BrushCard}"
                                    BorderBrush="{DynamicResource BrushError}"
                                    BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,10"
                                    Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVis}}">
                                <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource BrushError}"
                                           FontSize="12" TextWrapping="Wrap" />
                            </Border>

                            <!-- Generation Progress & Word Count -->
                            <Grid Margin="0,0,0,12">
                                <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}"
                                           VerticalAlignment="Center" />
                                <ProgressBar Height="3" IsIndeterminate="True"
                                             Visibility="{Binding IsGenerating, Converter={StaticResource BoolToVis}}"
                                             VerticalAlignment="Bottom" Foreground="{DynamicResource BrushAccent}" />
                            </Grid>

                            <!-- Action Buttons Grid -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Generate Button (Toggles Cancel if generating) -->
                                <Button Grid.Column="0" Style="{StaticResource StylePrimaryButton}"
                                        Command="{Binding GenerateReplyCommand}"
                                        Visibility="{Binding IsGenerating, Converter={StaticResource InverseBoolToVis}}"
                                        Padding="20,11" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconSparkles}" Fill="#FFFFFF"
                                              Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" />
                                        <TextBlock Text="Generate Reply" FontWeight="Bold" />
                                    </StackPanel>
                                </Button>

                                <Button Grid.Column="0" Style="{StaticResource StyleSecondaryButton}"
                                        Command="{Binding CancelGenerationCommand}"
                                        Visibility="{Binding IsGenerating, Converter={StaticResource BoolToVis}}"
                                        Content="Cancel Generation" Padding="16,10" Margin="0,0,8,0" />

                                <!-- Regenerate Button -->
                                <Button Grid.Column="1" Style="{StaticResource StyleSecondaryButton}"
                                        Command="{Binding GenerateReplyCommand}"
                                        Content="Regenerate" Padding="14,10" Margin="0,0,8,0" />

                                <!-- Outlook Draft Actions -->
                                <!-- Reply Draft Button -->
                                <Button Grid.Column="3" Style="{StaticResource StylePrimaryButton}"
                                        Command="{Binding CreateOutlookReplyDraftCommand}"
                                        CommandParameter="single"
                                        Padding="16,11" Margin="0,0,8,0"
                                        ToolTip="Create real reply draft with your Outlook signature and open in Outlook">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconMail}" Fill="#FFFFFF"
                                              Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" />
                                        <TextBlock Text="Create Draft in Outlook" FontWeight="Bold" />
                                    </StackPanel>
                                </Button>

                                <!-- Reply All / New Email dropdown or button -->
                                <Button Grid.Column="4" Style="{StaticResource StyleSecondaryButton}"
                                        Command="{Binding CreateOutlookReplyDraftCommand}"
                                        CommandParameter="all"
                                        Content="Reply All" Padding="12,10"
                                        ToolTip="Reply to all original recipients" />
                            </Grid>

                            <!-- Safety Guarantee Notice -->
                            <TextBlock Text="🔒 Guaranteed Safety: MailCraft AI will only display drafts in Outlook. It will NEVER send an email automatically."
                                       FontSize="10.5" Foreground="{DynamicResource BrushTextMuted}" Margin="0,8,0,0"
                                       HorizontalAlignment="Right" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- ================= BOTTOM STATUS FOOTER ================= -->
            <Border Grid.Row="2"
                    Background="{DynamicResource BrushSurface}"
                    BorderBrush="{DynamicResource BrushBorder}"
                    BorderThickness="0,1,0,0"
                    Padding="20,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="MailCraft AI v1.0 • Built with .NET 8, WPF &amp; Outlook COM Interop"
                               FontSize="11" Foreground="{DynamicResource BrushTextMuted}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="Global Hotkey: Ctrl+Alt+R"
                               FontSize="11" Foreground="{DynamicResource BrushTextMuted}" VerticalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>

        <!-- ================= MODAL DRAWER: SETTINGS ================= -->
        <Grid Background="#7F000000" Visibility="{Binding IsSettingsOpen, Converter={StaticResource BoolToVis}}">
            <Border Width="680" MaxHeight="720"
                    Background="{DynamicResource BrushSurface}"
                    BorderBrush="{DynamicResource BrushBorder}"
                    BorderThickness="1" CornerRadius="12"
                    Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid DataContext="{Binding SettingsVm}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /> <!-- Header -->
                        <RowDefinition Height="*" />    <!-- Settings Content -->
                        <RowDefinition Height="Auto" /> <!-- Footer Buttons -->
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <TextBlock Text="Settings &amp; Business Profile" FontSize="18" FontWeight="Bold" />
                        <Button Style="{StaticResource StyleIconButton}"
                                Command="{Binding DataContext.CloseSettingsAndSaveCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                HorizontalAlignment="Right">
                            <Path Data="{StaticResource IconClose}" Fill="{DynamicResource BrushTextSecondary}" Width="14" Height="14" Stretch="Uniform" />
                        </Button>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                        <StackPanel>
                            <!-- AI Provider Selection -->
                            <TextBlock Text="AI Provider &amp; API Key" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8" />
                            <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="Active Provider:" FontSize="12" Margin="0,0,0,4" />
                                    <ComboBox SelectedItem="{Binding ActiveProvider}" Style="{StaticResource StyleModernComboBox}" Margin="0,0,0,10">
                                        <models:AiProviderType>AnthropicClaude</models:AiProviderType>
                                        <models:AiProviderType>OpenAi</models:AiProviderType>
                                        <models:AiProviderType>GoogleGemini</models:AiProviderType>
                                    </ComboBox>

                                    <!-- Anthropic Claude Settings -->
                                    <StackPanel Visibility="{Binding ActiveProvider, Converter={StaticResource EnumToVis}, ConverterParameter=AnthropicClaude}">
                                        <TextBlock Text="Anthropic API Key (sk-ant-...):" FontSize="11.5" Margin="0,0,0,3" />
                                        <PasswordBox x:Name="PbClaude" PasswordChar="●" Margin="0,0,0,8" Height="32"
                                                     PasswordChanged="OnClaudePasswordChanged" />
                                        <TextBlock Text="Claude Model:" FontSize="11.5" Margin="0,0,0,3" />
                                        <ComboBox ItemsSource="{Binding ClaudeModels}" SelectedValuePath="ModelId"
                                                  SelectedValue="{Binding SelectedModelClaude}"
                                                  DisplayMemberPath="DisplayName" Style="{StaticResource StyleModernComboBox}" />
                                    </StackPanel>

                                    <!-- OpenAI Settings -->
                                    <StackPanel Visibility="{Binding ActiveProvider, Converter={StaticResource EnumToVis}, ConverterParameter=OpenAi}">
                                        <TextBlock Text="OpenAI API Key (sk-...):" FontSize="11.5" Margin="0,0,0,3" />
                                        <PasswordBox x:Name="PbOpenAi" PasswordChar="●" Margin="0,0,0,8" Height="32"
                                                     PasswordChanged="OnOpenAiPasswordChanged" />
                                        <TextBlock Text="OpenAI Model:" FontSize="11.5" Margin="0,0,0,3" />
                                        <ComboBox ItemsSource="{Binding OpenAiModels}" SelectedValuePath="ModelId"
                                                  SelectedValue="{Binding SelectedModelOpenAi}"
                                                  DisplayMemberPath="DisplayName" Style="{StaticResource StyleModernComboBox}" Margin="0,0,0,8" />
                                        <TextBlock Text="Custom Endpoint URL (Optional, for Azure OpenAI / proxies):" FontSize="11" Margin="0,0,0,3" />
                                        <TextBox Text="{Binding CustomOpenAiEndpoint, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource StyleRoundedTextBox}" />
                                    </StackPanel>

                                    <!-- Google Gemini Settings -->
                                    <StackPanel Visibility="{Binding ActiveProvider, Converter={StaticResource EnumToVis}, ConverterParameter=GoogleGemini}">
                                        <TextBlock Text="Google Gemini API Key:" FontSize="11.5" Margin="0,0,0,3" />
                                        <PasswordBox x:Name="PbGemini" PasswordChar="●" Margin="0,0,0,8" Height="32"
                                                     PasswordChanged="OnGeminiPasswordChanged" />
                                        <TextBlock Text="Gemini Model:" FontSize="11.5" Margin="0,0,0,3" />
                                        <ComboBox ItemsSource="{Binding GeminiModels}" SelectedValuePath="ModelId"
                                                  SelectedValue="{Binding SelectedModelGemini}"
                                                  DisplayMemberPath="DisplayName" Style="{StaticResource StyleModernComboBox}" />
                                    </StackPanel>

                                    <!-- Key Validation Button & Status -->
                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                        <Button Style="{StaticResource StyleSecondaryButton}" Command="{Binding ValidateCurrentKeyCommand}" Content="Test &amp; Validate API Key" />
                                        <TextBlock Text="{Binding ValidationMessage}" FontSize="11.5" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <TextBlock Text="🔒 API keys are encrypted locally using Windows DPAPI (CurrentUser). Never hardcoded or sent to third parties."
                                               FontSize="10.5" Foreground="{DynamicResource BrushTextMuted}" Margin="0,8,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- Profile & Business Context -->
                            <TextBlock Text="My Business Context (Injected into Replies)" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8" />
                            <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,6,8">
                                        <TextBlock Text="Your Full Name:" FontSize="11" Margin="0,0,0,3" />
                                        <TextBox Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource StyleRoundedTextBox}" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="6,0,0,8">
                                        <TextBlock Text="Job Title:" FontSize="11" Margin="0,0,0,3" />
                                        <TextBox Text="{Binding JobTitle, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource StyleRoundedTextBox}" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,6,8">
                                        <TextBlock Text="Company Name:" FontSize="11" Margin="0,0,0,3" />
                                        <TextBox Text="{Binding CompanyName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource StyleRoundedTextBox}" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="6,0,0,8">
                                        <TextBlock Text="Default Sign-Off:" FontSize="11" Margin="0,0,0,3" />
                                        <TextBox Text="{Binding DefaultSignOff, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource StyleRoundedTextBox}" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,0,0,8">
                                        <TextBlock Text="Company Description / Scope:" FontSize="11" Margin="0,0,0,3" />
                                        <TextBox Text="{Binding CompanyDescription, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource StyleRoundedTextBox}" Height="48" AcceptsReturn="True" TextWrapping="Wrap" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Margin="0,0,0,8">
                                        <TextBlock Text="Standard Phrases / Value Propositions:" FontSize="11" Margin="0,0,0,3" />
                                        <TextBox Text="{Binding StandardPhrases, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource StyleRoundedTextBox}" Height="40" AcceptsReturn="True" TextWrapping="Wrap" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="4" Grid.ColumnSpan="2">
                                        <TextBlock Text="Additional Style Instructions:" FontSize="11" Margin="0,0,0,3" />
                                        <TextBox Text="{Binding AdditionalInstructions, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource StyleRoundedTextBox}" Height="40" AcceptsReturn="True" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Privacy & Preferences -->
                            <TextBlock Text="Privacy &amp; Security Preferences" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8" />
                            <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="14">
                                <StackPanel>
                                    <CheckBox IsChecked="{Binding MaskPiiByDefault}" Margin="0,0,0,8">
                                        <TextBlock Text="Mask sensitive data (Emails, Phone numbers, IBANs, Credit Cards) before sending to AI" FontSize="12" />
                                    </CheckBox>
                                    <CheckBox IsChecked="{Binding AutoTrimLongContext}" Margin="0,0,0,8">
                                        <TextBlock Text="Intelligently trim older repetitive thread history when context exceeds 12,000 characters" FontSize="12" />
                                    </CheckBox>
                                    <CheckBox IsChecked="{Binding EnableGlobalHotkey}">
                                        <TextBlock Text="Enable Windows Global Hotkey (Ctrl+Alt+R) to pull from Outlook and open app" FontSize="12" />
                                    </CheckBox>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Footer Save Button -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <Button Style="{StaticResource StylePrimaryButton}"
                                Command="{Binding DataContext.CloseSettingsAndSaveCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                Content="Save &amp; Close" Padding="20,10" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ================= MODAL DRAWER: HISTORY ================= -->
        <Grid Background="#7F000000" Visibility="{Binding IsHistoryOpen, Converter={StaticResource BoolToVis}}">
            <Border Width="780" MaxHeight="680"
                    Background="{DynamicResource BrushSurface}"
                    BorderBrush="{DynamicResource BrushBorder}"
                    BorderThickness="1" CornerRadius="12"
                    Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid DataContext="{Binding HistoryVm}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /> <!-- Header -->
                        <RowDefinition Height="Auto" /> <!-- Search -->
                        <RowDefinition Height="*" />    <!-- Records List -->
                        <RowDefinition Height="Auto" /> <!-- Footer -->
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="Generation History (SQLite)" FontSize="18" FontWeight="Bold" />
                        <Button Style="{StaticResource StyleIconButton}"
                                Click="OnCloseHistoryClicked" HorizontalAlignment="Right">
                            <Path Data="{StaticResource IconClose}" Fill="{DynamicResource BrushTextSecondary}" Width="14" Height="14" Stretch="Uniform" />
                        </Button>
                    </Grid>

                    <!-- Search Input -->
                    <TextBox Grid.Row="1" Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource StyleRoundedTextBox}" Margin="0,0,0,12"
                             Padding="10,7" ToolTip="Search by subject, sender, prompt, or generated reply..." />

                    <!-- Records List & Preview Split -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="320" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Items List -->
                        <ListBox Grid.Column="0" ItemsSource="{Binding Records}"
                                 SelectedItem="{Binding SelectedRecord}"
                                 Background="{DynamicResource BrushCard}"
                                 BorderBrush="{DynamicResource BrushBorder}"
                                 BorderThickness="1">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="10,8" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding OriginalSubject}" FontWeight="SemiBold" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding OriginalSender}" FontSize="11" Foreground="{DynamicResource BrushTextMuted}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:g}'}" FontSize="10" Foreground="{DynamicResource BrushTextMuted}" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <Button Grid.Column="1" Style="{StaticResource StyleIconButton}"
                                                    Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    CommandParameter="{Binding}" VerticalAlignment="Center">
                                                <Path Data="{StaticResource IconStar}" Width="14" Height="14" Stretch="Uniform">
                                                    <Path.Style>
                                                        <Style TargetType="Path">
                                                            <Setter Property="Fill" Value="{DynamicResource BrushTextMuted}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                                    <Setter Property="Fill" Value="#F59E0B" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Path.Style>
                                                </Path>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Preview & Load to Editor -->
                        <Border Grid.Column="2" Background="{DynamicResource BrushCard}"
                                BorderBrush="{DynamicResource BrushBorder}"
                                BorderThickness="1" CornerRadius="8" Padding="14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Margin="0,0,0,8">
                                    <TextBlock Text="{Binding SelectedRecord.OriginalSubject, StringFormat='Subject: {0}'}" FontWeight="SemiBold" FontSize="13" />
                                    <TextBlock Text="{Binding SelectedRecord.ProviderName, StringFormat='Generated by: {0}'}" FontSize="11" Foreground="{DynamicResource BrushTextMuted}" />
                                </StackPanel>

                                <TextBox Grid.Row="1" Text="{Binding SelectedRecord.GeneratedReply, Mode=OneWay}"
                                         IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto" Background="Transparent"
                                         BorderThickness="0" FontSize="12" />

                                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                                    <Button Style="{StaticResource StyleSecondaryButton}"
                                            Command="{Binding DeleteRecordCommand}"
                                            CommandParameter="{Binding SelectedRecord}"
                                            Content="Delete Record" Margin="0,0,8,0" />
                                    <Button Style="{StaticResource StylePrimaryButton}"
                                            Command="{Binding LoadSelectedIntoEditorCommand}"
                                            Content="Load into Editor" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Footer -->
                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,12,0,0">
                        <Button Style="{StaticResource StyleSecondaryButton}" Command="{Binding ClearAllCommand}" Content="Clear All History" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ================= MODAL DIALOG: PRIVACY NOTICE ================= -->
        <Grid Background="#7F000000" Visibility="{Binding IsPrivacyNoticeOpen, Converter={StaticResource BoolToVis}}">
            <Border Width="520" Background="{DynamicResource BrushSurface}"
                    BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"
                    CornerRadius="12" Padding="24"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Path Data="{StaticResource IconShield}" Fill="{DynamicResource BrushSuccess}" Width="20" Height="20" Stretch="Uniform" Margin="0,0,8,0" />
                        <TextBlock Text="Privacy &amp; Data Security Notice" FontSize="16" FontWeight="Bold" />
                    </StackPanel>

                    <TextBlock Text="MailCraft AI is architected with strict enterprise privacy principles:"
                               FontSize="12.5" FontWeight="SemiBold" Margin="0,0,0,8" />

                    <TextBlock Text="• Your Private Key: Email content is sent directly from your PC to your chosen AI provider (Anthropic, OpenAI, or Google) using your own API key. There is no intermediate MailCraft proxy server."
                               FontSize="12" TextWrapping="Wrap" Margin="0,0,0,6" />
                    <TextBlock Text="• Zero Cloud Storage: All history and settings are saved locally on this computer (%APPDATA%\MailCraftAI) using SQLite and Windows DPAPI encryption."
                               FontSize="12" TextWrapping="Wrap" Margin="0,0,0,6" />
                    <TextBlock Text="• Automatic PII Masking: When enabled, emails, phone numbers, and IBANs are masked before being transmitted to the AI and restored only after the reply is returned."
                               FontSize="12" TextWrapping="Wrap" Margin="0,0,0,6" />
                    <TextBlock Text="• Manual Review Required: MailCraft AI will NEVER automatically send emails. It will exclusively create drafts in Outlook for you to review, edit, and send."
                               FontSize="12" TextWrapping="Wrap" Margin="0,0,0,16" />

                    <Button Style="{StaticResource StylePrimaryButton}" Click="OnClosePrivacyNoticeClicked"
                            Content="Got It" HorizontalAlignment="Right" Padding="20,8" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
