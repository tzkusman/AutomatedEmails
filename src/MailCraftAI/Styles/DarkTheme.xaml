<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="ColorBackground">#0F1117</Color>
    <Color x:Key="ColorSurface">#161922</Color>
    <Color x:Key="ColorCard">#1D212C</Color>
    <Color x:Key="ColorCardHover">#242937</Color>
    <Color x:Key="ColorBorder">#2C3242</Color>
    <Color x:Key="ColorBorderFocus">#6366F1</Color>
    <Color x:Key="ColorAccent">#6366F1</Color>
    <Color x:Key="ColorAccentHover">#4F46E5</Color>
    <Color x:Key="ColorTextPrimary">#F8FAFC</Color>
    <Color x:Key="ColorTextSecondary">#94A3B8</Color>
    <Color x:Key="ColorTextMuted">#64748B</Color>

    <SolidColorBrush x:Key="BrushBackground" Color="{StaticResource ColorBackground}" />
    <SolidColorBrush x:Key="BrushSurface" Color="{StaticResource ColorSurface}" />
    <SolidColorBrush x:Key="BrushCard" Color="{StaticResource ColorCard}" />
    <SolidColorBrush x:Key="BrushCardHover" Color="{StaticResource ColorCardHover}" />
    <SolidColorBrush x:Key="BrushBorder" Color="{StaticResource ColorBorder}" />
    <SolidColorBrush x:Key="BrushBorderFocus" Color="{StaticResource ColorBorderFocus}" />
    <SolidColorBrush x:Key="BrushAccent" Color="{StaticResource ColorAccent}" />
    <SolidColorBrush x:Key="BrushAccentHover" Color="{StaticResource ColorAccentHover}" />
    <SolidColorBrush x:Key="BrushTextPrimary" Color="{StaticResource ColorTextPrimary}" />
    <SolidColorBrush x:Key="BrushTextSecondary" Color="{StaticResource ColorTextSecondary}" />
    <SolidColorBrush x:Key="BrushTextMuted" Color="{StaticResource ColorTextMuted}" />

    <LinearGradientBrush x:Key="BrushAccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#6366F1" Offset="0" />
        <GradientStop Color="#8B5CF6" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BrushHeaderGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#161922" Offset="0" />
        <GradientStop Color="#1A1E29" Offset="1" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="BrushSuccess" Color="#10B981" />
    <SolidColorBrush x:Key="BrushWarning" Color="#F59E0B" />
    <SolidColorBrush x:Key="BrushError" Color="#EF4444" />
</ResourceDictionary>
