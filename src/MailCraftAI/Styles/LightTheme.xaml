<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Executive Professional White & Outlook Blue Palette -->
    <Color x:Key="ColorBackground">#F4F6F9</Color>
    <Color x:Key="ColorSurface">#FFFFFF</Color>
    <Color x:Key="ColorCard">#FFFFFF</Color>
    <Color x:Key="ColorCardHover">#F8FAFC</Color>
    <Color x:Key="ColorBorder">#E2E8F0</Color>
    <Color x:Key="ColorBorderFocus">#0078D4</Color>
    <Color x:Key="ColorAccent">#0078D4</Color>
    <Color x:Key="ColorAccentHover">#106EBE</Color>
    <Color x:Key="ColorTextPrimary">#0F172A</Color>
    <Color x:Key="ColorTextSecondary">#334155</Color>
    <Color x:Key="ColorTextMuted">#64748B</Color>

    <SolidColorBrush x:Key="BrushBackground" Color="{StaticResource ColorBackground}" />
    <SolidColorBrush x:Key="BrushSurface" Color="{StaticResource ColorSurface}" />
    <SolidColorBrush x:Key="BrushCard" Color="{StaticResource ColorCard}" />
    <SolidColorBrush x:Key="BrushCardHover" Color="{StaticResource ColorCardHover}" />
    <SolidColorBrush x:Key="BrushBorder" Color="{StaticResource ColorBorder}" />
    <SolidColorBrush x:Key="BrushBorderFocus" Color="{StaticResource ColorBorderFocus}" />
    <SolidColorBrush x:Key="BrushAccent" Color="{StaticResource ColorAccent}" />
    <SolidColorBrush x:Key="BrushAccentHover" Color="{StaticResource ColorAccentHover}" />
    <SolidColorBrush x:Key="BrushTextPrimary" Color="{StaticResource ColorTextPrimary}" />
    <SolidColorBrush x:Key="BrushTextSecondary" Color="{StaticResource ColorTextSecondary}" />
    <SolidColorBrush x:Key="BrushTextMuted" Color="{StaticResource ColorTextMuted}" />

    <!-- Executive Outlook Gradient -->
    <LinearGradientBrush x:Key="BrushAccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#0078D4" Offset="0" />
        <GradientStop Color="#005A9E" Offset="1" />
    </LinearGradientBrush>

    <!-- Clean White Header Gradient -->
    <LinearGradientBrush x:Key="BrushHeaderGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FFFFFF" Offset="0" />
        <GradientStop Color="#F8FAFC" Offset="1" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="BrushSuccess" Color="#059669" />
    <SolidColorBrush x:Key="BrushWarning" Color="#D97706" />
    <SolidColorBrush x:Key="BrushError" Color="#DC2626" />
</ResourceDictionary>
